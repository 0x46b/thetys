menu "Thetys: Humidity Sensors"
     config MAX_SENSOR_COUNT
     	    int "Maximum number of sensors used"
     	    default 8
	    help
		Sets an upper limit of sensors that are supported

     config NUM_CALIBRATION_SAMPLES
     	    int "Number of readings for calibration"
	    default 50
	    help
		Calibration is done due many readings, which gets averaged. This is the number of readings to take per calibration

     config SENSOR_POLLING_TIME_IN_MS
    	   int "Polling time for the sensors in ms"
	   default 60000
	   help
		This configures the time between the sensor readings in milliseconds

    config SENSOR_POLLING_CORE
     	   int "Core the polling task should run on"
	   default 1
	   range 0 1
	   help
		The task for the sensor-polling will get executed on this CPU-core

    config SENSOR_WATER_REFERENCE_VALUE
    	   int "Raw value that is expected to get from the sensor if submerged in water (=100% humidity)"
	   default 4095

    config SENSOR_AIR_REFERENCE_VALUE
           int "Raw value that is expected to get from the sensor if no water at all (=0% humidity)"
	   default 0
endmenu
